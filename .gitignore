# =============================================================================
#  BedwarsRecoded — .gitignore
#  Build output, IDE state, OS cruft, runtime files and (above all) secrets.
#  Anything a fresh clone can regenerate does not belong in the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# Build output — regenerated by `mvn`
# -----------------------------------------------------------------------------
target/
**/target/
*.class

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
nbproject/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Operating systems
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Runtime state and logs
# -----------------------------------------------------------------------------
logs/
run/
*.log
hs_err_pid*
replay_pid*
crash-reports/

# -----------------------------------------------------------------------------
# Secrets — never commit these.
#   The tracked *.env.example files are templates with placeholder values; they
#   are the only env files that belong in the repository.
# -----------------------------------------------------------------------------
.env
*.env
!.env.example
kubeconfig
secrets.yaml
*.pem
*.key
*.p12
*.jks
*.keystore

# -----------------------------------------------------------------------------
# Generated by install.sh.
#   values-install.yaml carries the generated database and object-storage
#   passwords, so it is secret material even though it is not named .env.
#   .installer/ is local state: the run log, and what --teardown/--resume need.
# -----------------------------------------------------------------------------
.installer/
deploy/helm/values-install.yaml

# -----------------------------------------------------------------------------
# Local world copies and throwaway test fixtures.
#   The committed arena templates live under deploy/templates/, which is NOT
#   ignored — only here-and-there working copies are.
# -----------------------------------------------------------------------------
dev-worlds/
*.slime
session.lock

# -----------------------------------------------------------------------------
# Server jars. A Minecraft server jar is ~50-90 MB of someone else's build output,
# so the image resolves it at build time (see server-jars/README.md) instead of the
# repository carrying it. The folder and its README stay tracked; the jars do not.
# -----------------------------------------------------------------------------
server-jars/*.jar
