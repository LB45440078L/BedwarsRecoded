# Copy to .env and adjust. All values have safe local defaults in the compose file.

BEDWARS_DB_NAME=bedwars
BEDWARS_DB_USER=bedwars
BEDWARS_DB_PASSWORD=bedwars
BEDWARS_DB_ROOT_PASSWORD=rootpw
BEDWARS_DB_PORT=3306

BEDWARS_S3_ACCESS_KEY=minioadmin
BEDWARS_S3_SECRET_KEY=minioadmin
BEDWARS_S3_BUCKET=bedwars-templates

# Optional image overrides (upstream images are the defaults). Networks that
# cannot reach quay.io can use the legacy Bitnami mirrors:
#   BEDWARS_MINIO_IMAGE=bitnamilegacy/minio:latest
#   BEDWARS_MC_IMAGE=bitnamilegacy/minio-client:latest

# Only used by the optional game server (`docker compose --profile game`).
# SERVER_ENGINE=spigot -> built with BuildTools UNLESS a jar sits in server-jars/,
#                         in which case that jar is used and nothing is compiled.
# SERVER_ENGINE=paper  -> downloaded from the PaperMC API; never compiled.
SERVER_ENGINE=spigot
SPIGOT_REV=26.3
PAPER_VERSION=26.3

# Shared secret for the controller's write endpoints (/pods/*, /lobby/queue).
# Leave it empty and the controller runs OPEN, which is fine on a private host and
# not fine anywhere else (see docs/MANUAL.md chapter 21). When you set it, it must
# reach BOTH the controller and its clients: compose passes this one value to the
# controller, the proxy and the game pod, and the controller forwards it to every
# container it provisions itself. Generating one:
#   openssl rand -base64 40 | tr -dc 'A-Za-z0-9' | cut -c1-32
# install.sh generates one for you by default.
BEDWARS_API_TOKEN=

# TESTING ONLY. true runs the proxy in offline mode (Velocity online-mode=false):
# it skips the Mojang check, so a client with no account can connect -- and anyone
# who can reach the port can join under any name. Never enable it on a public
# server. See docs/MANUAL.md 9.4.8.
BEDWARS_OFFLINE_MODE=false