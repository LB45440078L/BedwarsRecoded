# Copy to .env and adjust. All values have safe local defaults in the compose file.

BEDWARS_DB_NAME=bedwars
BEDWARS_DB_USER=bedwars
BEDWARS_DB_PASSWORD=bedwars
BEDWARS_DB_ROOT_PASSWORD=rootpw
BEDWARS_DB_PORT=3306

BEDWARS_S3_ACCESS_KEY=minioadmin
BEDWARS_S3_SECRET_KEY=minioadmin
BEDWARS_S3_BUCKET=bedwars-templates

# Only used by the optional `game` profile.
PAPER_VERSION=26.2
PAPER_BUILD=129